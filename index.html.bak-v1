<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Payments &amp; Mastercard &#183; Study Guide</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#16223C; --slate:#4C5666; --mute:#7C8598;
  --paper:#FBFAF7; --card:#FFFFFF; --rule:#E4E1D9;
  --gold:#A67C2E; --gold-bg:#FBF4E4;
  --teal:#17635C; --teal-bg:#E9F2F0;
  --plum:#4A3A6B; --plum-bg:#EFEDF4;
  --rail:272px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
html.np-lock,html.np-lock body{overflow:hidden}
body{
  margin:0;background:var(--paper);color:var(--slate);
  font-family:"IBM Plex Sans",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  font-size:17.2px;line-height:1.66;-webkit-font-smoothing:antialiased;
}
.num{font-family:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
  font-variant-numeric:tabular-nums;font-size:.94em;letter-spacing:-.01em;color:var(--ink)}

/* ---- rail ---- */
.rail{position:fixed;inset:0 auto 0 0;width:var(--rail);background:var(--ink);
  color:#C9D1E0;display:flex;flex-direction:column;z-index:20}
.rail-h{padding:22px 22px 14px}
.rail-h-row{display:flex;align-items:center;gap:9px}
.rail-h .mc-logo{flex:0 0 auto;width:26px;height:auto}
.rail-h b{display:block;color:#fff;font-size:15px;font-weight:600;letter-spacing:-.01em;line-height:1.3}
.rail-h span{display:block;color:#8FA0BC;font-size:12.5px;margin-top:3px}
.srch{margin:0 16px 12px;position:relative}
.srch input{width:100%;padding:8px 10px 8px 30px;border-radius:6px;border:1px solid #2C3A5C;
  background:#0F1930;color:#E6EBF3;font:inherit;font-size:13.5px}
.srch input::placeholder{color:#6F7E9B}
.srch input:focus{outline:2px solid var(--gold);outline-offset:1px;border-color:transparent}
.srch svg{position:absolute;left:9px;top:50%;transform:translateY(-50%);width:14px;height:14px;
  stroke:#6F7E9B;fill:none;stroke-width:2}
nav{flex:1;overflow-y:auto;padding:0 10px 10px}
nav ul{list-style:none;margin:0;padding:0}
nav a{display:flex;align-items:center;gap:9px;padding:6px 10px;border-radius:6px;
  color:#C2CCDD;text-decoration:none;font-size:13.4px;line-height:1.35}
nav a:hover{background:#22304F;color:#fff}
nav a.on{background:#26365A;color:#fff}
nav a:focus-visible{outline:2px solid var(--gold);outline-offset:-2px}
.nv-n{font-family:"IBM Plex Mono",monospace;font-size:11.5px;color:#7F90AF;width:14px;flex:none;text-align:right}
nav a.on .nv-n{color:var(--gold)}
.nv-t{flex:1}
.nv-d{width:6px;height:6px;border-radius:50%;background:transparent;flex:none}
.nv-d.done{background:var(--gold)}
.rail-f{padding:12px 22px 18px;border-top:1px solid #26324E;font-size:12.5px;color:#8FA0BC}
.bar{height:3px;background:#26324E;border-radius:2px;margin-top:8px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--gold);width:0;transition:width .3s ease}

/* ---- main ---- */
main{margin-left:var(--rail);padding:0 clamp(20px,2.2vw,44px) 120px}
.wrap{max-width:1240px;margin:0 auto}

/* hero */
.hero{padding:64px 0 40px;border-bottom:1px solid var(--rule);margin-bottom:16px}
.hero h1{margin:0;color:var(--ink);font-size:42px;line-height:1.12;font-weight:600;letter-spacing:-.022em;max-width:17ch}
.hero p.lede{margin:17px 0 0;font-size:18.5px;max-width:62ch;color:var(--slate)}
.hero .meta{margin-top:22px;font-size:13.5px;color:var(--mute);display:flex;flex-wrap:wrap;gap:6px 22px}
.hero .meta b{color:var(--ink);font-weight:600}
.hero .dgw{margin:34px 0 0}

/* chapters */
.ch{padding:52px 0 8px;border-top:1px solid var(--rule);scroll-margin-top:20px}
.ch:first-of-type{border-top:0}
.ch-h{margin-bottom:22px}
.ch-meta{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:9px}
.ch-k{font-family:"IBM Plex Mono",monospace;font-size:12px;color:var(--gold);letter-spacing:.02em}
.ch h2{margin:0;color:var(--ink);font-size:29px;line-height:1.22;font-weight:600;letter-spacing:-.018em;max-width:30ch}
.done{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--mute);cursor:pointer;user-select:none}
.done input{accent-color:var(--gold);width:14px;height:14px;cursor:pointer;margin:0}
.done:hover{color:var(--ink)}

h3.sec{color:var(--ink);font-size:19.5px;font-weight:600;margin:40px 0 10px;letter-spacing:-.012em;line-height:1.32}
h4.sub{color:var(--gold);font-size:14.5px;font-weight:600;margin:26px 0 6px;letter-spacing:-.005em}
main p{margin:0 0 15px}
main ul{margin:0 0 17px;padding-left:0;list-style:none}
main li{position:relative;padding-left:19px;margin-bottom:8px}
main li:before{content:"";position:absolute;left:3px;top:.72em;width:5px;height:5px;
  border-radius:50%;background:var(--rule);border:1px solid #CFCABD}
main strong{color:var(--ink);font-weight:600}

/* callouts */
.c{margin:18px 0;padding:13px 17px;border-left:3px solid;border-radius:0 6px 6px 0}
.c-l{display:block;font-size:12.5px;font-weight:600;margin-bottom:3px;letter-spacing:-.005em}
.c-b{font-size:16px;line-height:1.58}
.c-bridge{background:var(--teal-bg);border-color:var(--teal)}
.c-bridge .c-l{color:var(--teal)}
.c-bridge .c-b{color:#1B3B38}
.c-key{background:var(--gold-bg);border-color:var(--gold)}
.c-key .c-l{color:#8A6524}
.c-key .c-b{color:#4A3B1C}
.c-test{background:var(--plum-bg);border-color:var(--plum)}
.c-test .c-l{color:var(--plum)}
.c-test .c-b{color:#2E2545}
.c-pm{background:transparent;border-color:var(--rule);padding-top:2px;padding-bottom:2px}
.c-pm .c-l{color:var(--mute)}
.c-pm .c-b{font-style:italic;color:var(--slate)}
blockquote.q{margin:20px 0;padding:0 0 0 20px;border-left:2px solid var(--gold);
  font-size:17.5px;line-height:1.55;color:var(--ink)}

/* tables */
.tw{margin:20px 0;overflow-x:auto;border:1px solid var(--rule);border-radius:7px;background:var(--card)}
table{border-collapse:collapse;width:100%;font-size:15.2px}
th{background:var(--ink);color:#fff;text-align:left;padding:10px 14px;font-weight:600;font-size:13.6px;
  letter-spacing:-.005em;white-space:nowrap}
td{padding:10px 14px;border-top:1px solid var(--rule);vertical-align:top;line-height:1.5}
td:first-child{color:var(--ink);font-weight:600;white-space:nowrap}
tbody tr:nth-child(even){background:#FCFBF8}

/* diagrams */
.dgw{margin:24px 0 26px;padding:0}
.dg{width:100%;height:auto;display:block;max-width:900px;overflow:visible}
.dg text{font-family:"IBM Plex Sans",sans-serif;font-size:13px;fill:var(--ink)}
.n-plain rect{fill:#F2F0EA;stroke:#CFCABD;stroke-width:1}
.n-bank rect{fill:#EAEEF5;stroke:#B9C4D6;stroke-width:1}
.n-net rect{fill:var(--gold-bg);stroke:var(--gold);stroke-width:1.4}
.n-plain text,.n-bank text,.n-net text{font-weight:600;font-size:13.5px}
.req line{stroke:var(--ink);stroke-width:1.5}
.resp{stroke:var(--gold);stroke-width:1.5;stroke-dasharray:5 4}
.dg text.cap{font-size:12px;fill:var(--mute)}
.n-phase rect{fill:var(--teal-bg);stroke:var(--teal);stroke-width:1.4}
.n-phase text{font-weight:600;font-size:14px}
.n-phase text.sub{font-weight:400;font-size:12.5px;fill:var(--slate);
  font-family:"IBM Plex Mono",monospace}
.ph{stroke:var(--teal);stroke-width:1.5}
.ph2{stroke:var(--slate);stroke-width:1.4}
.wf-t{font-weight:600;font-size:14px}
.wf-keep{fill:#EDEBE4;stroke:#D6D1C4}
.wf-ix{fill:#DCE3EF;stroke:#B9C4D6}
.wf-mc{fill:var(--gold);stroke:#8A6524}
.wf-aq{fill:#CFE0DC;stroke:#9BBDB6}
.wf-bar{stroke-width:1}
.wf-in{font-size:13px;font-weight:600}
.wf-leg text{font-size:12.8px;fill:var(--slate)}
.wf-sw{stroke-width:1}
.q-ax{font-size:12px;fill:var(--mute)}
.q-cell rect{stroke-width:1.2}
.q-good rect{fill:#EDF3F1;stroke:#B7CFC9}
.q-bad rect{fill:#FBF0EA;stroke:#E3C6B4}
.q-h{font-weight:600;font-size:14px}
.q-b{font-size:12.8px;fill:var(--slate)}
.fr rect{stroke-width:1.2}
.f1 rect{fill:#EDF3F1;stroke:#B7CFC9}
.f2 rect{fill:#F6F1E4;stroke:#DBCFAE}
.f3 rect{fill:#FAEEE4;stroke:#E5C7AC}
.f4 rect{fill:#F8E9E6;stroke:#E0BCB4}
.fr-s{font-size:13.2px;font-weight:600}
.fr-a{font-size:12.6px;fill:var(--slate)}
.ly rect{fill:#F4F2EC;stroke:#D8D3C6;stroke-width:1.2}
.ly-mid rect:first-child{fill:#F9F7F1}
.ly-h{font-weight:600;font-size:13.6px}
.ly-b{font-size:12.6px;fill:var(--slate)}
.st-a rect{fill:#EAEEF5;stroke:#B9C4D6;stroke-width:1.2}
.st-b rect{fill:var(--gold-bg);stroke:var(--gold);stroke-width:1.2}
.st-h{font-weight:600;font-size:13px}
.st-b text,.st .st-b{font-size:12.4px}
.st text.st-b{fill:var(--slate)}
.sg-h{font-weight:600;font-size:13.4px}
.sg-hum{fill:var(--teal)}
.sg-agt{fill:#A03B2E}
.sg-ch{fill:#EDF3F1;stroke:#B7CFC9;stroke-width:1.1}
.sg-ca{fill:#F8E9E6;stroke:#E0BCB4;stroke-width:1.1}
.sg-t{font-size:12.9px}
.sg-v{font-size:11.5px;fill:var(--mute)}
.rg rect{stroke-width:1.2}
.r1 rect{fill:#EDF3F1;stroke:#B7CFC9}
.r2 rect{fill:#F6F1E4;stroke:#DBCFAE}
.r3 rect{fill:var(--gold-bg);stroke:var(--gold)}
.rg-h{font-weight:600;font-size:13.4px}
.rg-b{font-size:12.6px;fill:var(--slate)}
.rg-ax{font-size:11.5px;fill:var(--mute)}
.tl-r{stroke:var(--rule);stroke-width:2}
.tl circle{fill:var(--gold);stroke:var(--paper);stroke-width:3}
.tl-d{font-family:"IBM Plex Mono",monospace;font-size:11.5px;fill:var(--mute)}
.tl-t{font-weight:600;font-size:14px}
.tl-b{font-size:12.6px;fill:var(--slate)}

/* hero animation: one orchestrated moment */
@media (prefers-reduced-motion:no-preference){
  .req.anim line{stroke-dasharray:24;stroke-dashoffset:24;animation:dr .4s ease forwards}
  .req.anim line:nth-child(1){animation-delay:.25s}
  .req.anim line:nth-child(2){animation-delay:.45s}
  .req.anim line:nth-child(3){animation-delay:.65s}
  .req.anim line:nth-child(4){animation-delay:.85s}
  .resp.anim{stroke-dasharray:5 4;opacity:0;animation:fi .5s ease 1.25s forwards}
  .cap.anim{opacity:0;animation:fi .5s ease 1.5s forwards}
  @keyframes dr{to{stroke-dashoffset:0}}
  @keyframes fi{to{opacity:1}}
}

/* search state */
body.searching .ch{display:none}
body.searching .ch.hit{display:block}
body.searching .hero{display:none}
mark{background:#FBE7B0;color:var(--ink);padding:0 1px;border-radius:2px}
.nores{display:none;padding:60px 0;color:var(--mute)}
body.searching .nores.on{display:block}

.top{position:fixed;right:26px;bottom:26px;width:38px;height:38px;border-radius:50%;
  background:var(--ink);color:#fff;border:0;cursor:pointer;opacity:0;pointer-events:none;
  transition:opacity .2s;display:grid;place-items:center;font-size:15px;z-index:15}
.top.on{opacity:1;pointer-events:auto}
.top:focus-visible{outline:2px solid var(--gold);outline-offset:2px}

@media (max-width:1000px){
  .rail{position:static;width:auto;height:auto}
  nav{max-height:190px}
  main{margin-left:0;padding:0 22px 80px}
  .hero{padding:34px 0 26px}
  .hero h1{font-size:29px}
}

/* ============ annotation layer ============ */
mark.hl{padding:1px 0;border-radius:2px;cursor:pointer;background:var(--h-y);
  box-shadow:inset 0 -1px 0 rgba(0,0,0,.08)}
mark.hl.h-y{background:#FBE9A8}
mark.hl.h-g{background:#CFE9CE}
mark.hl.h-b{background:#CFE0F4}
mark.hl.h-p{background:#EBD8EC}
mark.hl.has-n{box-shadow:inset 0 -2px 0 var(--ink)}
mark.hl:hover{filter:brightness(.96)}

/* hover preview — a real positioned element (not a pseudo-element anchored to the
   inline mark) so it can't get clipped by the mark's own inline box */
.hlt{position:absolute;z-index:59;display:none;min-width:120px;max-width:260px;width:max-content;
  background:var(--ink);color:#fff;font-size:12.8px;font-weight:400;line-height:1.5;
  white-space:pre-wrap;word-wrap:break-word;text-align:left;
  padding:8px 11px;border-radius:8px;box-shadow:0 8px 22px rgba(12,20,40,.30);
  pointer-events:none}
.hlt.on{display:block}

/* highlight action toolbar — selection (picking a color) and existing highlights (comment/color/delete) */
.htb{position:absolute;z-index:60;display:none;gap:2px;padding:6px;background:var(--ink);
  border-radius:8px;box-shadow:0 6px 22px rgba(12,20,40,.28);align-items:center}
.htb.on{display:flex}
.sw{width:20px;height:20px;border-radius:50%;border:1.5px solid rgba(255,255,255,.35);cursor:pointer;padding:0}
.sw:hover{transform:scale(1.12)}
.sw:focus-visible{outline:2px solid #fff;outline-offset:1px}
.sw-y{background:#FBE9A8}.sw-g{background:#CFE9CE}.sw-b{background:#CFE0F4}.sw-p{background:#EBD8EC}
.htb-pick{display:none;gap:5px;align-items:center}
.htb.picking .htb-pick{display:flex}
.htb-view{display:flex;gap:2px;align-items:center}
.htb.picking .htb-view{display:none}
.htb-sep{width:1px;height:18px;background:#38476B;margin:0 2px}
.htb-ic{background:transparent;border:0;color:#DCE4F0;cursor:pointer;padding:6px;border-radius:6px;
  display:grid;place-items:center}
.htb-ic:hover{background:#2B3A5C;color:#fff}
.htb-ic svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round}
.htb-dot{width:18px;height:18px;border-radius:50%;border:1.5px solid rgba(255,255,255,.4);cursor:pointer;padding:0}
.htb-dot:hover{transform:scale(1.12)}
.htb-dot.h-y{background:#FBE9A8}.htb-dot.h-g{background:#CFE9CE}.htb-dot.h-b{background:#CFE0F4}.htb-dot.h-p{background:#EBD8EC}
.htb-recolor{display:flex;gap:5px;align-items:center;padding:0 2px}

/* highlight comment box */
.hcb{position:absolute;z-index:61;display:none;width:300px;background:var(--card);
  border:1px solid var(--rule);border-radius:9px;box-shadow:0 10px 32px rgba(12,20,40,.20);padding:13px}
.hcb.on{display:block}
.hcb-q{font-size:13px;color:var(--slate);background:#F6F4EE;border-radius:5px;padding:7px 9px;
  margin-bottom:9px;max-height:74px;overflow:auto;line-height:1.45}
.hcb-body{font-size:14px;color:var(--ink);line-height:1.55;white-space:pre-wrap}
.hcb-meta{display:flex;align-items:center;justify-content:space-between;margin-top:9px;
  padding-top:8px;border-top:1px dotted var(--rule)}
.hcb-time{font-size:11.5px;color:var(--mute);font-family:"IBM Plex Mono",monospace}
.hcb-link{background:transparent;border:0;color:var(--gold);font:inherit;font-size:12.5px;
  cursor:pointer;padding:2px 4px}
.hcb-link:hover{text-decoration:underline}
.hcb-ta{width:100%;min-height:82px;resize:vertical;border:1px solid var(--rule);border-radius:6px;
  padding:8px 9px;font:inherit;font-size:14px;color:var(--ink);background:var(--paper)}
.hcb-ta:focus{outline:2px solid var(--gold);outline-offset:0;border-color:transparent}
.hcb-a{display:flex;justify-content:flex-end;margin-top:9px;gap:8px}
.btn{border:1px solid var(--rule);background:var(--card);color:var(--ink);font:inherit;font-size:13px;
  padding:6px 12px;border-radius:6px;cursor:pointer}
.btn:hover{background:#F4F2EC}
.btn-p{background:var(--ink);color:#fff;border-color:var(--ink)}
.btn-p:hover{background:#22314F}
.btn-d{color:#9B3B2E;border-color:#E4CCC6}
.btn-d:hover{background:#FBEFEC}
.btn:focus-visible{outline:2px solid var(--gold);outline-offset:1px}

/* per-part notes + workspace entries */
.ynotes{margin:30px 0 8px;padding-top:16px;border-top:1px dashed var(--rule)}
.ynotes-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.ynotes-h span{font-size:12.5px;color:var(--mute)}
.yn{background:#FCFBF7;border:1px solid var(--rule);border-left:3px solid var(--teal);
  border-radius:0 7px 7px 0;padding:11px 14px;margin-bottom:10px}
.yn-m{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:5px}
.yn-d{font-family:"IBM Plex Mono",monospace;font-size:11px;color:var(--mute)}
.yn-x{display:flex;gap:4px}
.yn-x button{border:0;background:transparent;color:var(--mute);font:inherit;font-size:12px;
  cursor:pointer;padding:2px 6px;border-radius:4px}
.yn-x button:hover{background:#EFEDE6;color:var(--ink)}
.yn-body{font-size:16px;line-height:1.58}
.yn-body p{margin:0 0 8px;max-width:none}
.yn-body h4{color:var(--ink);font-size:15.5px;margin:8px 0 4px}
.yn-body h5{color:var(--gold);font-size:14px;margin:8px 0 4px}
.yn-body ul{margin:4px 0 8px;max-width:none}
.yn-body code{font-family:"IBM Plex Mono",monospace;font-size:.9em;background:#F1EFE8;padding:1px 4px;border-radius:3px}
.yn-body a{color:var(--teal)}
.ed{width:100%;min-height:110px;resize:vertical;border:1px solid var(--rule);border-radius:7px;
  padding:11px 13px;font:inherit;font-size:15px;color:var(--ink);background:var(--card);line-height:1.55}
.ed:focus{outline:2px solid var(--gold);outline-offset:0;border-color:transparent}
.ed-a{display:flex;gap:8px;align-items:center;margin-top:8px}
.ed-h{font-size:12px;color:var(--mute);margin-left:auto}

/* rail: annotations + data */
.rail-tools{padding:0 16px 12px}
.rt{width:100%;border:0;background:#FFFFFF;color:var(--ink);font:inherit;
  font-size:13.4px;font-weight:600;padding:9px 12px;border-radius:8px;cursor:pointer;
  display:flex;align-items:center;gap:9px;text-align:left;box-shadow:0 1px 3px rgba(0,0,0,.22)}
.rt svg{width:15px;height:15px;flex:none;fill:none;stroke:var(--gold);stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round}
.rt-l{flex:1}
.rt-n{flex:none;min-width:20px;padding:1px 7px;border-radius:999px;background:var(--gold-bg);
  color:#8A6524;font-size:11.6px;font-weight:600;text-align:center}
.rt-n:empty{display:none}
.rt:hover{background:#F4F6FA}
.rt:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.rt:focus-visible{outline:2px solid var(--gold);outline-offset:1px}
.rt b{display:block;font-size:13.5px;color:#fff;font-weight:600}

/* annotations drawer */
.drawer{position:fixed;top:0;right:0;bottom:0;width:378px;background:var(--card);z-index:70;
  border-left:1px solid var(--rule);box-shadow:-8px 0 30px rgba(12,20,40,.13);
  transform:translateX(100%);transition:transform .22s ease;display:flex;flex-direction:column}
.drawer.on{transform:none}
@media (prefers-reduced-motion:reduce){.drawer{transition:none}}
.dr-h{padding:16px 18px 12px;border-bottom:1px solid var(--rule);display:flex;
  align-items:center;justify-content:space-between}
.dr-h b{color:var(--ink);font-size:15px}
.dr-x{border:0;background:transparent;font-size:19px;line-height:1;color:var(--mute);cursor:pointer;padding:2px 6px}
.dr-x:hover{color:var(--ink)}
.dr-b{flex:1;overflow-y:auto;padding:12px 18px 26px}
.ai{border-left:3px solid var(--rule);padding:2px 0 2px 11px;margin-bottom:15px;cursor:pointer}
.ai:hover{border-left-color:var(--gold)}
.ai-w{font-size:11.5px;color:var(--mute);font-family:"IBM Plex Mono",monospace;margin-bottom:3px}
.ai-t{font-size:14px;color:var(--ink);line-height:1.45}
.ai-n{font-size:13.4px;color:var(--slate);font-style:italic;margin-top:4px;
  border-top:1px dotted var(--rule);padding-top:4px}
.dr-empty{color:var(--mute);font-size:14.5px;line-height:1.6;padding:16px 0}

/* persistent notes pad */
.np-btn{position:fixed;top:18px;right:24px;z-index:65;display:flex;align-items:center;gap:7px;
  border:1px solid var(--rule);background:var(--card);color:var(--ink);font:inherit;font-size:13px;
  font-weight:600;padding:8px 14px;border-radius:999px;cursor:pointer;box-shadow:0 4px 14px rgba(12,20,40,.12)}
.np-btn:hover{background:var(--gold-bg);border-color:var(--gold)}
.np-btn svg{width:15px;height:15px;flex:none;fill:none;stroke:var(--gold);stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round}
.np-btn:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
@media (max-width:1000px){.np-btn{top:auto;bottom:74px;right:20px;padding:10px;border-radius:50%}.np-btn span{display:none}}

.np-bd{position:fixed;inset:0;background:rgba(15,20,35,.30);z-index:79;opacity:0;pointer-events:none;
  transition:opacity .18s ease}
.np-bd.on{opacity:1;pointer-events:auto}

.np{position:fixed;top:0;right:0;bottom:0;width:420px;max-width:92vw;background:var(--card);z-index:80;
  border-left:1px solid var(--rule);box-shadow:-8px 0 30px rgba(12,20,40,.16);
  transform:translateX(100%);transition:transform .22s ease;display:flex;flex-direction:column}
.np.on{transform:translateX(0)}
.np.full{top:4vh;bottom:4vh;width:min(1040px,94vw);border-radius:12px;box-shadow:0 24px 60px rgba(12,20,40,.30)}
.np.full.on{left:50%;right:auto;transform:translateX(-50%)}
@media (prefers-reduced-motion:reduce){.np{transition:none}}
.np-h{padding:16px 18px 12px;border-bottom:1px solid var(--rule);display:flex;align-items:center;gap:6px}
.np-h b{color:var(--ink);font-size:15px;flex:1}
.np-ic{border:0;background:transparent;color:var(--mute);cursor:pointer;padding:5px 6px;border-radius:6px;
  display:grid;place-items:center}
.np-ic:hover{background:#F4F6FA;color:var(--ink)}
.np-ic svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round}
.np-tb{display:flex;align-items:center;gap:2px;padding:10px 14px;border-bottom:1px solid var(--rule)}
.np-tbb{border:1px solid transparent;background:transparent;color:var(--ink);font:inherit;font-size:13.5px;
  cursor:pointer;width:28px;height:28px;border-radius:6px;display:grid;place-items:center}
.np-tbb:hover{background:#F4F6FA;border-color:var(--rule)}
.np-tbb b{font-weight:700}
.np-tbb i{font-style:italic}
.np-tbb u{text-decoration:underline}
.np-tbb svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round}
.np-tb-sep{width:1px;height:18px;background:var(--rule);margin:0 5px}
.np-fs-input{width:34px;border:1px solid transparent;background:transparent;color:var(--ink);
  font:inherit;font-size:11px;text-align:center;border-radius:4px;padding:2px 0;
  appearance:textfield;-moz-appearance:textfield}
.np-fs-input::-webkit-inner-spin-button,.np-fs-input::-webkit-outer-spin-button{
  -webkit-appearance:none;margin:0}
.np-fs-input:hover{border-color:var(--rule)}
.np-fs-input:focus{outline:2px solid var(--gold);outline-offset:0;border-color:transparent;background:var(--paper)}
.np-b{flex:1;min-height:0;display:flex;padding:14px 18px 18px}
.np-t{flex:1;min-height:0;width:100%;outline:0;font:inherit;font-size:15px;line-height:1.65;
  color:var(--ink);background:transparent;overflow-y:auto;overscroll-behavior:contain}
.np-t:empty:before{content:attr(data-placeholder);color:var(--mute);pointer-events:none}
.np-t b,.np-t strong{font-weight:700}
.np-t i,.np-t em{font-style:italic}
.np-t u{text-decoration:underline}
.np-t ul{list-style:disc;margin:6px 0;padding-left:26px}
.np-t ol{margin:6px 0;padding-left:26px}
.np-t li{margin:3px 0}
.np-t ul.np-todo{list-style:none;padding-left:2px}
.np-t ul.np-todo li{display:flex;align-items:flex-start;gap:8px}
.np-t ul.np-todo li input[type="checkbox"]{margin:4px 0 0;flex:none;width:15px;height:15px;
  accent-color:var(--ink);cursor:pointer}
.np-t ul.np-todo li.np-done{color:var(--mute);text-decoration:line-through}

.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(12px);background:var(--ink);
  color:#fff;padding:9px 16px;border-radius:7px;font-size:13.5px;z-index:90;opacity:0;
  pointer-events:none;transition:opacity .2s,transform .2s}
.toast.on{opacity:1;transform:translateX(-50%)}
.warn{background:#FBEFEC;border:1px solid #E4CCC6;color:#8A3123;padding:9px 14px;border-radius:7px;
  font-size:13.5px;margin:14px 0}

@media print{
  .rail,.htb,.hcb,.hlt,.drawer,.top,.np-btn,.np,.np-bd,.ynotes-h button,.newsec,.ed-a{display:none!important}
  main{margin:0;padding:0;max-width:none}
  .ch{page-break-inside:auto;border-top:1px solid #ccc}
  mark.hl{background:#F3F3F3!important;box-shadow:none}
  body{font-size:11pt}
}
.nv-grp{padding:11px 10px 4px;font-size:11px;color:#7F90AF;letter-spacing:.03em}


/* ============ home / dashboard ============ */
body[data-view="home"] .ch,body[data-view="home"] .hero,body[data-view="home"] #nores{display:none}
body[data-view="doc"] #home{display:none}
body.searching #home{display:none!important}
/* the dashboard is wide; the reading view stays narrow */
body[data-view="home"] .wrap{max-width:1240px}


#home{padding:20px 0 34px}
.home-top{display:block}
.home-top h1{margin:0;color:var(--ink);font-size:31px;font-weight:600;letter-spacing:-.022em;line-height:1.1}
.home-top .lede{margin:6px 0 0;font-size:16.5px;color:var(--ink);font-weight:500}
.home-sub{margin:4px 0 0;font-size:13.8px;color:var(--mute);max-width:74ch}
.home-r{display:flex;align-items:center;gap:14px}
.saved-note{font-size:12.6px;color:var(--mute);display:flex;align-items:center;gap:7px;white-space:nowrap}
.saved-note i{width:7px;height:7px;border-radius:50%;background:#3FA88E;display:inline-block}

.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:14px 0 12px}
@media (max-width:1150px){.stats{grid-template-columns:repeat(3,1fr)}}
@media (max-width:700px){.stats{grid-template-columns:repeat(2,1fr)}}
.stat{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:11px 13px;
  display:flex;align-items:center;gap:11px}
.ico{width:36px;height:36px;border-radius:10px;flex:none;display:flex;align-items:center;justify-content:center;align-self:center}
.ico svg{width:20px;height:20px;display:block;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}
.i-blue{background:#E7EEF9}.i-blue svg{stroke:#3A6BB5}
.i-green{background:#E6F2EC}.i-green svg{stroke:#2E7D64}
.i-violet{background:#EDEAF7}.i-violet svg{stroke:#5B4C9B}
.i-amber{background:#FBF0DE}.i-amber svg{stroke:#B0812A}
.i-rose{background:#FBEAE7}.i-rose svg{stroke:#B0503E}
.i-teal{background:#E3F1F0}.i-teal svg{stroke:#17635C}
.i-slate{background:#EAEDF2}.i-slate svg{stroke:#4C5666}
.stat b{display:block;color:var(--ink);font-size:19px;font-weight:600;line-height:1.15;letter-spacing:-.015em}
.stat span{display:block;font-size:12.4px;color:var(--mute);margin-top:2px}
.stat.s-go b{font-size:15.5px}

.home-grid{display:grid;grid-template-columns:2.05fr 1fr;gap:12px}
@media (max-width:1000px){.home-grid{grid-template-columns:1fr}}
.panel{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:14px 16px}
.panel h4{margin:0;color:var(--ink);font-size:15px;font-weight:600;letter-spacing:-.008em}
.panel .psub{margin:2px 0 0;font-size:12.8px;color:var(--mute)}
.panel .dg{margin-top:8px;max-width:660px}
.plink{display:inline-block;margin-top:8px;color:#3A6BB5;text-decoration:none;font-size:13.6px;font-weight:500}
.plink:hover{text-decoration:underline}
.ph-r{display:flex;align-items:center;justify-content:space-between;gap:10px}

.ring-wrap{display:flex;align-items:center;gap:16px;margin-top:12px}
.ring{flex:none;position:relative;width:104px;height:104px}
.ring svg{transform:rotate(-90deg)}
.ring-t{position:absolute;inset:0;display:grid;place-items:center;font-size:21px;font-weight:600;color:var(--ink)}
.ring-l{font-size:13px;line-height:1.85}
.ring-l i{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:8px;vertical-align:middle}
.rl-a{background:#3FA88E}.rl-b{background:#E0A33C}.rl-c{background:#CFCABD}
.ring-note{margin-top:9px;font-size:12.8px;color:var(--mute);line-height:1.5}

.h3s{color:var(--ink);font-size:16px;font-weight:600;margin:16px 0 9px;letter-spacing:-.01em}
.topics{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}
@media (max-width:1150px){.topics{grid-template-columns:repeat(2,1fr)}}
@media (max-width:640px){.topics{grid-template-columns:1fr}}
.tcard{background:var(--card);border:1px solid var(--rule);border-radius:10px;padding:12px 13px;
  text-decoration:none;display:flex;gap:11px;align-items:flex-start;cursor:pointer;text-align:left;
  font:inherit;width:100%}
.tcard:hover{border-color:#C3CCDA;box-shadow:0 2px 10px rgba(20,30,55,.05)}
.tcard:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.tc-b{min-width:0}
.tc-t{display:block;color:var(--ink);font-size:14.4px;font-weight:600;line-height:1.3}
.tc-d{display:block;font-size:12.5px;color:var(--slate);margin-top:3px;line-height:1.4}
.tc-g{display:block;font-size:11.5px;color:var(--mute);margin-top:6px;line-height:1.35}
.tc-n{display:inline-block;font-size:11.4px;color:var(--teal);background:#E9F2F0;border:1px solid #B7CFC9;
  border-radius:999px;padding:1px 8px;margin-top:8px}

.home-cols{display:grid;grid-template-columns:1.35fr 1fr;gap:12px;margin-top:12px}
@media (max-width:1000px){.home-cols{grid-template-columns:1fr}}
.viewall{color:#3A6BB5;text-decoration:none;font-size:13px;font-weight:500;background:none;border:0;cursor:pointer}
.viewall:hover{text-decoration:underline}
.rlist{margin-top:8px}
.ritem{display:flex;align-items:center;gap:10px;padding:7px 0;border-top:1px solid var(--rule);
  cursor:pointer;text-decoration:none}
.ritem:first-child{border-top:0}
.ritem:hover .rt{color:#3A6BB5}
.rt{flex:1;color:var(--ink);font-size:13.8px;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.rbadge{flex:none;font-size:11.2px;padding:2px 9px;border-radius:999px;border:1px solid}
.rb-note{color:#3A6BB5;border-color:#C6D6EE;background:#EDF3FB}
.rb-hl{color:#8A6524;border-color:#DBCFAE;background:var(--gold-bg)}
.rb-ws{color:var(--plum);border-color:#CFC8DE;background:var(--plum-bg)}
.rdate{flex:none;font-size:12px;color:var(--mute);min-width:52px;text-align:right}
.empty-s{color:var(--mute);font-size:13.4px;line-height:1.6;padding:22px 0;text-align:center}
.pinbtn{border:0;background:transparent;color:var(--mute);cursor:pointer;font-size:12px;padding:2px 6px;border-radius:4px}
.pinbtn:hover{background:#EFEDE6;color:var(--ink)}
.pinbtn.on{color:var(--gold)}

.nav-home{margin-bottom:4px}
body[data-view="home"] .nav-home a{background:#26365A;color:#fff}
body[data-view="home"] nav a[data-nav].on{background:transparent;color:#C2CCDD}

/* wider screen, larger type - fills the width without absurd line lengths */
@media (min-width:1600px){body{font-size:18px}}
@media (min-width:2000px){body{font-size:19.2px}}
</style>
</head>
<body>
<aside class="rail">
  <div class="rail-h">
    <div class="rail-h-row">
      <svg class="mc-logo" viewBox="0 0 152 100" role="img" aria-label="Mastercard logo">
        <circle cx="60" cy="50" r="42" fill="#EB001B"/>
        <circle cx="92" cy="50" r="42" fill="#F79E1B"/>
        <path d="M76 16.5a42 42 0 0 1 0 67 42 42 0 0 1 0-67z" fill="#FF5F00"/>
      </svg>
      <b>Payments &amp; Mastercard</b>
    </div>
    <span>Everything before day one</span>
  </div>
  <div class="srch">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input id="q" type="search" placeholder="Search the guide  /" aria-label="Search the guide">
  </div>
  <div class="rail-tools">
    <button class="rt" id="open-dr">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.7 3.8h10.6v16.8L12 16.5l-5.3 4.1z"/></svg>
      <span class="rt-l">Highlights</span>
      <span class="rt-n" id="dr-n"></span>
    </button>
  </div>
  <nav><ul><li class="nav-home"><a href="#home" id="nav-home"><span class="nv-n">&#8962;</span><span class="nv-t">Home</span></a></li><li><a href="#ch0" data-nav="0"><span class="nv-n">0</span><span class="nv-t">The One Mental Shift That Makes Everything Click</span><span class="nv-d" data-dot="0"></span></a></li><li><a href="#ch1" data-nav="1"><span class="nv-n">1</span><span class="nv-t">How a Payment Actually Works (The Plumbing)</span><span class="nv-d" data-dot="1"></span></a></li><li><a href="#ch2" data-nav="2"><span class="nv-n">2</span><span class="nv-t">Fraud, Risk &amp; Payment Performance (Your Team’s World)</span><span class="nv-d" data-dot="2"></span></a></li><li><a href="#ch3" data-nav="3"><span class="nv-n">3</span><span class="nv-t">Mastercard the Company, DI Pro, and Your Likely Team</span><span class="nv-d" data-dot="3"></span></a></li><li><a href="#ch4" data-nav="4"><span class="nv-n">4</span><span class="nv-t">Agentic AI in Payments (Why They Hired You)</span><span class="nv-d" data-dot="4"></span></a></li><li><a href="#ch5" data-nav="5"><span class="nv-n">5</span><span class="nv-t">Trends, Standards &amp; Key Metrics</span><span class="nv-d" data-dot="5"></span></a></li><li><a href="#ch6" data-nav="6"><span class="nv-n">6</span><span class="nv-t">The Actual Problem Your Team Is Solving</span><span class="nv-d" data-dot="6"></span></a></li><li><a href="#ch7" data-nav="7"><span class="nv-n">7</span><span class="nv-t">What You Actually Own as an Agentic AI PM</span><span class="nv-d" data-dot="7"></span></a></li><li><a href="#ch8" data-nav="8"><span class="nv-n">8</span><span class="nv-t">Your First 90 Days</span><span class="nv-d" data-dot="8"></span></a></li><li><a href="#ch9" data-nav="9"><span class="nv-n">9</span><span class="nv-t">Stakeholders and Influence</span><span class="nv-d" data-dot="9"></span></a></li><li><a href="#ch10" data-nav="10"><span class="nv-n">10</span><span class="nv-t">Culture, Pace, and What Surprises People</span><span class="nv-d" data-dot="10"></span></a></li><li><a href="#ch11" data-nav="11"><span class="nv-n">&#183;</span><span class="nv-t">Quick-Reference Glossary</span><span class="nv-d" data-dot="11"></span></a></li><li><a href="#ch12" data-nav="12"><span class="nv-n">&#183;</span><span class="nv-t">Progress Tracker</span><span class="nv-d" data-dot="12"></span></a></li></ul>
    <ul id="nav-ws"></ul></nav>
  <div class="rail-f">
    <span id="cnt">0 of 0 read</span>
    <div class="bar"><i id="barfill"></i></div>
  </div>
</aside>

<div class="htb no-ann" id="htb" role="toolbar" aria-label="Highlight">
  <div class="htb-pick" id="htb-pick">
    <button class="sw sw-y" data-c="h-y" title="Yellow" aria-label="Highlight yellow"></button>
    <button class="sw sw-g" data-c="h-g" title="Green" aria-label="Highlight green"></button>
    <button class="sw sw-b" data-c="h-b" title="Blue" aria-label="Highlight blue"></button>
    <button class="sw sw-p" data-c="h-p" title="Purple" aria-label="Highlight purple"></button>
    <span class="htb-sep"></span>
    <button class="htb-ic" id="htb-newcomment" title="Comment" aria-label="Comment">
      <svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.35 0-2.6-.32-3.7-.9L3 21l1.9-5.7A8.46 8.46 0 0 1 3.5 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z"/></svg>
    </button>
  </div>
  <div class="htb-view" id="htb-view">
    <button class="htb-ic" id="htb-comment" title="Comment" aria-label="Comment">
      <svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.35 0-2.6-.32-3.7-.9L3 21l1.9-5.7A8.46 8.46 0 0 1 3.5 11.5 8.5 8.5 0 0 1 12 3a8.5 8.5 0 0 1 9 8.5z"/></svg>
    </button>
    <span class="htb-recolor" id="htb-recolor"></span>
    <button class="htb-ic" id="htb-del" title="Delete" aria-label="Delete highlight">
      <svg viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>
    </button>
  </div>
</div>

<div class="hcb no-ann" id="hcb">
  <div class="hcb-q" id="hcb-q"></div>
  <div id="hcb-note"></div>
</div>

<div class="hlt no-ann" id="hlt"></div>

<aside class="drawer no-ann" id="drawer" aria-label="Your highlights">
  <div class="dr-h"><b>Highlights</b><button class="dr-x" id="dr-close" aria-label="Close">&#215;</button></div>
  <div class="dr-b" id="dr-b"></div>
</aside>

<button class="np-btn" id="np-open" aria-label="Open notes" aria-expanded="false">
  <svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg>
  <span>Notes</span>
</button>
<div class="np-bd" id="np-bd"></div>
<aside class="np no-ann" id="np" aria-label="Your notes">
  <div class="np-h">
    <b>Notes</b>
    <button class="np-ic" id="np-expand" aria-label="Expand to full screen" title="Expand">
      <svg viewBox="0 0 24 24"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6"/></svg>
    </button>
    <button class="np-ic" id="np-close" aria-label="Close notes" title="Close">
      <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="np-tb" role="toolbar" aria-label="Formatting">
    <button class="np-tbb" id="np-bold" type="button" title="Bold (Ctrl+B)" aria-label="Bold"><b>B</b></button>
    <button class="np-tbb" id="np-ital" type="button" title="Italic (Ctrl+I)" aria-label="Italic"><i>I</i></button>
    <button class="np-tbb" id="np-und" type="button" title="Underline (Ctrl+U)" aria-label="Underline"><u>U</u></button>
    <span class="np-tb-sep"></span>
    <button class="np-tbb" id="np-list" type="button" title="Bullet list" aria-label="Bullet list">
      <svg viewBox="0 0 24 24"><circle cx="4" cy="6" r="1.3" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="1.3" fill="currentColor" stroke="none"/><circle cx="4" cy="18" r="1.3" fill="currentColor" stroke="none"/><path d="M9 6h11M9 12h11M9 18h11"/></svg>
    </button>
    <button class="np-tbb" id="np-check" type="button" title="Checklist / to-do" aria-label="Checklist">
      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 12l3 3 7-7"/></svg>
    </button>
    <span class="np-tb-sep"></span>
    <button class="np-tbb" id="np-fs-dec" type="button" title="Decrease text size" aria-label="Decrease text size">&#8722;</button>
    <input type="number" class="np-fs-input" id="np-fs-input" value="15" min="8" max="60" step="1" aria-label="Text size in pixels" title="Type an exact text size (applies to the selection, or text typed next)">
    <button class="np-tbb" id="np-fs-inc" type="button" title="Increase text size" aria-label="Increase text size">&#43;</button>
  </div>
  <div class="np-b"><div class="np-t" id="np-t" contenteditable="true" data-placeholder="Start typing…" spellcheck="true"></div></div>
</aside>

<main>
 <div class="wrap">
  <section id="home">
    <div class="home-top">
      <div>
        <h1>Payments &amp; Mastercard</h1>
        <p class="lede">Everything to know before day one</p>
        <p class="home-sub">Your hub to learn payments, understand the ecosystem, and be ready to contribute.</p>
      </div>
    </div>

    <div class="stats no-ann" id="stats"></div>

    <div class="home-grid no-ann">
